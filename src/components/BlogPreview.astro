---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import maintenance from "../assets/galeria/trabajo-en-techo.jpeg";
import rooftop from "../assets/galeria/cubierta-comercial.jpeg";

const posts = (await getCollection("blog")).sort((a, b) => a.data.order - b.data.order);
const covers = {
  "cuando-limpiar-tus-paneles-solares": maintenance,
  "como-funciona-la-energia-solar": rooftop,
} as Record<string, ImageMetadata>;
interface Props { full?: boolean }
const { full = false } = Astro.props;
const Heading = full ? "h1" : "h2";
---
<section id="blog" class="bg-cream py-9 sm:py-11" aria-labelledby="blog-title">
  <div class="shell">
    <Heading id="blog-title" class="section-title">{full ? "Blog de energía solar para hogares y negocios" : "Blog"}</Heading>
    <div class="mt-6 grid gap-4 lg:grid-cols-2">
      {(full ? posts : posts.slice(0, 2)).map(({ id, data }) => (
        <article class="grid overflow-hidden rounded-xl border border-orange-100 bg-white sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
          {covers[id] && (
            <Image src={covers[id]} alt="" widths={[320, 480, 640]} sizes="(min-width: 1024px) 20vw, (min-width: 640px) 40vw, 100vw" class="aspect-video size-full max-h-56 object-cover sm:aspect-auto sm:max-h-none" />
          )}
          <div class="p-5">
            <h3 class="text-xl leading-tight font-extrabold tracking-tight">
              <a class="hover:text-brand hover:underline" href={`/blog/${id}/`}>{data.title}</a>
            </h3>
            <p class="mt-2">{data.description}</p>
            <a class="mt-3 inline-flex min-h-11 items-center font-bold text-brand underline underline-offset-4" href={`/blog/${id}/`} aria-label={`Leer artículo: ${data.title}`}>Leer artículo</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
