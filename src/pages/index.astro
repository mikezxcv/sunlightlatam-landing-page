import Gallery from "../components/Gallery.astro";
import BlogPreview from "../components/BlogPreview.astro";
import { business } from "../data/business";
---
<BaseLayout title={`${business.name} | Paneles solares en ${business.area}`} description={business.description}>
  <Hero />
  <ServiceCards />
  <Gallery />
  <BlogPreview />
</BaseLayout>
