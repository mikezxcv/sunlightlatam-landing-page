---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services } from "../../data/services";
import { business } from "../../data/business";

export function getStaticPaths() {
  return services.map(service => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
---
<BaseLayout title={`${service.title} | ${business.name}`} description={service.description}>
  <article class="shell py-10 sm:py-16">
    <div class="mx-auto max-w-3xl">
      <a href="/servicios/" class="font-bold text-brand underline">Volver a servicios</a>
      <h1 class="section-title mt-5">{service.title}</h1>
      <p class="my-5 text-lg">{service.description}</p>
      <Image src={service.image} alt={service.alt} widths={[480, 768, 1200]} sizes="(min-width: 800px) 768px, 100vw" class="aspect-[3/2] w-full rounded-xl object-cover" />
      {service.paragraphs.map(paragraph => <p class="mt-5 leading-relaxed">{paragraph}</p>)}
      <a class="action mt-6" href="/contacto/">Solicita una cotización</a>
    </div>
  </article>
</BaseLayout>
